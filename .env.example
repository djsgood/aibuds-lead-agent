# Development worker only. Never copy campaign credentials/state into this repo.
ZYTE_API_KEY=
LEAD_AGENT_DB=/data/lead-agent.sqlite3
LEAD_AGENT_MAX_DAILY_CALLS=60
# Accounting estimate per attempted Zyte request, not a price claim.
LEAD_AGENT_ESTIMATED_CALL_COST_USD=0.01
LEAD_AGENT_MAX_DAILY_COST_USD=1.00
GOOGLE_SERVICE_ACCOUNT_JSON=
LEADS_SPREADSHEET_ID=
LEADS_SHEET_TAB=Lead Review
HUNTER_API_KEY=
HUNTER_MAX_DAILY_CALLS=10
HUNTER_ESTIMATED_CALL_COST_USD=0.05
HUNTER_MAX_DAILY_COST_USD=1.00
LEAD_AGENT_CONFIG=config/targets.json
ENABLE_SCHEDULE=false
LEAD_AGENT_INTERVAL_SECONDS=86400
# Never set a campaign/send endpoint here.
