# Development worker only. Never copy campaign credentials/state into this repo.
LEAD_AGENT_DB=/data/lead-agent.sqlite3
LEAD_AGENT_MAX_DAILY_CALLS=60
LEAD_AGENT_ESTIMATED_CALL_COST_USD=0.01
LEAD_AGENT_MAX_DAILY_COST_USD=1.00
GOOGLE_SERVICE_ACCOUNT_JSON=
LEADS_SPREADSHEET_ID=
LEADS_SHEET_TAB=Lead Review
LEAD_AGENT_CONFIG=config/targets.json
ENABLE_SCHEDULE=false
LEAD_AGENT_INTERVAL_SECONDS=3062
# Never set a campaign/send endpoint here.
# Optional local model. Blank disables interpretation; qualification remains deterministic.
OLLAMA_MODEL=
# Optional cloud model. Explicitly choose this backend; it never sends outreach or changes qualification.
LEAD_AGENT_MODEL_BACKEND=
OPENAI_MODEL=gpt-5-mini
# Set OPENAI_API_KEY only through the secure setup flow, never commit it.
OPENAI_API_KEY=
# No live campaign/send/import endpoint is accepted by this agent.
