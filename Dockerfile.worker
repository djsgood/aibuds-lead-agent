FROM python:3.12-slim
WORKDIR /app
COPY requirements-crawler.txt ./
RUN pip install --no-cache-dir -r requirements-crawler.txt beautifulsoup4
COPY --chown=10001:10001 aibuds_crawler/ ./aibuds_crawler/
COPY --chown=10001:10001 lead_agent/ ./lead_agent/
COPY --chown=10001:10001 config/ ./config/
COPY --chown=10001:10001 firecrawl_smoke.py ./firecrawl_smoke.py
CMD ["python", "-m", "lead_agent.daily"]
